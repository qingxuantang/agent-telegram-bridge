<!-- Template: replace YOUR_USERNAME with your macOS username in the paths below. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codex.telegram-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOUR_USERNAME/codex-tg/scripts/run-bridge.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME</string>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/.codex/tg/bridge-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/.codex/tg/bridge-launchd.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/Users/YOUR_USERNAME/.npm-global/bin:/Users/YOUR_USERNAME/.bun/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
